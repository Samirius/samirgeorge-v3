---
import Base from '../layouts/Base.astro';
---

<Base title="Contact">
  <div class="max-w-4xl mx-auto px-6 py-24">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-accent font-mono text-sm">04</span>
      <div class="h-px w-12 bg-accent/30"></div>
      <span class="text-sm text-secondary uppercase tracking-widest">Contact</span>
    </div>

    <h1 class="text-3xl md:text-5xl font-bold text-text mb-6 leading-tight">
      Let's build something<span class="text-accent">.</span>
    </h1>
    <p class="text-secondary text-lg mb-12 max-w-xl">
      Got a project? Need technical help? Want to work together? Keep it simple — just reach out.
    </p>

    <div class="grid md:grid-cols-3 gap-4 mb-16">
      <a href="mailto:samir@sabbk.com" class="group p-6 rounded-xl border border-white/5 bg-white/[0.02] hover:border-accent/20 hover:bg-accent/5 transition-all duration-300">
        <div class="text-accent mb-4">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </div>
        <span class="text-sm text-secondary mb-2 block">Email</span>
        <span class="text-text group-hover:text-accent transition-colors font-medium">samir@sabbk.com</span>
      </a>

      <a href="https://sabbk.com" target="_blank" rel="noopener noreferrer" class="group p-6 rounded-xl border border-white/5 bg-white/[0.02] hover:border-accent/20 hover:bg-accent/5 transition-all duration-300">
        <div class="text-accent mb-4">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
        </div>
        <span class="text-sm text-secondary mb-2 block">Sabbk</span>
        <span class="text-text group-hover:text-accent transition-colors font-medium">sabbk.com</span>
      </a>

      <div class="group p-6 rounded-xl border border-white/5 bg-white/[0.02]">
        <div class="text-accent mb-4">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        </div>
        <span class="text-sm text-secondary mb-2 block">Location</span>
        <span class="text-text font-medium">Cairo, Egypt</span>
      </div>
    </div>

    <div class="bg-surface rounded-xl border border-border p-8">
      <h2 class="text-2xl font-semibold text-text mb-4">How I work</h2>
      <div class="space-y-4 text-secondary leading-relaxed">
        <p>I keep it simple. Tell me what you need, I'll tell you if I can help. No sales pitches, no fluff.</p>
        <div class="grid sm:grid-cols-2 gap-4 mt-6">
          <div class="p-4 rounded-lg bg-bg border border-border">
            <span class="text-accent font-mono text-sm">01</span>
            <h3 class="text-text font-medium mt-2">You describe the problem</h3>
            <p class="text-sm text-secondary mt-1">Not the solution — the problem. I'll figure out the best approach.</p>
          </div>
          <div class="p-4 rounded-lg bg-bg border border-border">
            <span class="text-accent font-mono text-sm">02</span>
            <h3 class="text-text font-medium mt-2">I give you an honest answer</h3>
            <p class="text-sm text-secondary mt-1">Build, buy, or fix. Whichever makes sense for your situation.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>
