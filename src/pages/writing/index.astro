---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title="Writing" description="Articles about building products, systems thinking, and the Middle East tech landscape.">
  <article class="max-w-section mx-auto px-6 py-16">
    <header class="mb-16 reveal">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-text">Writing</h1>
      <p class="mt-4 text-secondary text-lg max-w-2xl">
        Thoughts on building products, systems thinking, and the Middle East tech landscape.
      </p>
    </header>

    <section class="space-y-1 reveal">
      {posts.map((post) => (
        <a href={`/writing/${post.id}/`} class="group hover:bg-surfaceHover rounded-lg p-5 -mx-4 transition-all cursor-pointer block border-b border-border">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1">
              <h2 class="text-text font-semibold group-hover:text-accent transition-colors mb-1">{post.data.title}</h2>
              <p class="text-sm text-secondary leading-relaxed">{post.data.description}</p>
              {post.data.tags && (
                <div class="flex flex-wrap gap-2 mt-3">
                  {post.data.tags.map((tag: string) => (
                    <span class="text-xs px-2 py-0.5 rounded bg-accent/10 text-accent">{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <span class="text-sm text-secondary shrink-0 mt-1">{formatDate(post.data.pubDate)}</span>
          </div>
        </a>
      ))}
    </section>
  </article>
</Base>
