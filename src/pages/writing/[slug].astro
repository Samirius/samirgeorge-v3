---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title={post.data.title} description={post.data.description}>
  <article class="max-w-prose mx-auto px-6 py-16">
    <header class="mb-12">
      <a href="/writing" class="text-sm text-secondary hover:text-accent transition-colors">← Writing</a>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-text mt-6 leading-tight">{post.data.title}</h1>
      <div class="flex items-center gap-4 mt-4 text-sm text-secondary">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.tags && post.data.tags.map((tag: string) => (
          <span class="px-2 py-0.5 rounded bg-accent/10 text-accent text-xs">{tag}</span>
        ))}
      </div>
    </header>
    <div class="prose prose-invert">
      <Content />
    </div>
    <div class="mt-16">
      <a href="/writing" class="text-sm text-secondary hover:text-accent transition-colors">← Back to writing</a>
    </div>
  </article>
</Base>
