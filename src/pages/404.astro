---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Page Not Found">
  <div class="max-w-3xl mx-auto px-6 py-32 text-center">
    <span class="text-accent font-mono text-sm mb-4 block">404</span>
    <h1 class="text-4xl md:text-6xl font-bold text-text mb-6">Page not found<span class="text-accent">.</span></h1>
    <p class="text-secondary text-lg mb-10">This page doesn't exist — or it was never built.</p>
    <a href="/" class="inline-block bg-accent text-bg px-6 py-3 rounded-lg font-medium hover:bg-accentHover transition-colors">Go home →</a>
  </div>
</Base>
