---
import Base from '../../layouts/Base.astro';
---

<Base title="أعمالي" lang="ar">
  <div class="max-w-6xl mx-auto px-6 py-24">
    <h1 class="text-3xl md:text-5xl font-bold text-text mb-6 leading-tight" dir="rtl">اللي بنيت<span class="text-accent">.</span></h1>
    <p class="text-secondary text-lg mb-16 max-w-2xl" dir="rtl">مش مشاريع جانبية — منتجات حقيقية بمستخدمين حقيقيين.</p>

    <div class="grid md:grid-cols-2 gap-4 mb-12">
      <div class="md:row-span-2 group relative rounded-2xl border border-white/5 bg-white/[0.02] p-8 hover:border-accent/20 transition-all duration-300 overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-accent/5 rounded-full blur-[80px] group-hover:bg-accent/10 transition-all"></div>
        <div class="relative z-10">
          <span class="px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full border border-accent/20 mb-6 inline-block">الورشة</span>
          <h3 class="text-2xl md:text-3xl font-bold text-text mb-4 group-hover:text-accent transition-colors" dir="rtl">Sabbk سبك</h3>
          <p class="text-secondary leading-relaxed mb-8" dir="rtl">ورشتي التقنية. ذكاء اصطناعي وبرمجيات واستشارات للأعمال في الخليج.</p>
          <a href="https://sabbk.com" target="_blank" rel="noopener noreferrer" class="text-accent text-sm font-medium hover:underline">← sabbk.com</a>
          <div class="flex flex-wrap gap-2 mt-6">
            <span class="px-3 py-1 text-xs bg-white/5 text-secondary rounded-md">ذكاء اصطناعي</span>
            <span class="px-3 py-1 text-xs bg-white/5 text-secondary rounded-md">برمجيات</span>
            <span class="px-3 py-1 text-xs bg-white/5 text-secondary rounded-md">استشارات</span>
          </div>
        </div>
      </div>

      <a href="https://hr.sabbk.com" target="_blank" rel="noopener noreferrer" class="group relative rounded-2xl border border-white/5 bg-white/[0.02] p-6 hover:border-accent/20 transition-all duration-300">
        <span class="px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full border border-accent/20 mb-4 inline-block">منتج</span>
        <h3 class="text-xl font-bold text-text mb-2 group-hover:text-accent transition-colors">myHR</h3>
        <p class="text-secondary text-sm leading-relaxed mb-4" dir="rtl">نظام موارد بشرية ومرتبات حديث للشركات في المنطقة.</p>
        <div class="flex flex-wrap gap-2">
          <span class="px-2 py-0.5 text-xs bg-white/5 text-secondary rounded-md">Laravel</span>
          <span class="px-2 py-0.5 text-xs bg-white/5 text-secondary rounded-md">Vue</span>
        </div>
      </a>

      <div class="group relative rounded-2xl border border-white/5 bg-white/[0.02] p-6 hover:border-accent/20 transition-all duration-300">
        <span class="px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full border border-accent/20 mb-4 inline-block">تم الإطلاق</span>
        <h3 class="text-xl font-bold text-text mb-2 group-hover:text-accent transition-colors">Sanadi سندي</h3>
        <p class="text-secondary text-sm leading-relaxed mb-4" dir="rtl">تطبيق تذكير بالأدوية للأسر. خلّي اللي بتحبهم على المسار.</p>
        <div class="flex flex-wrap gap-2">
          <span class="px-2 py-0.5 text-xs bg-white/5 text-secondary rounded-md">صحة</span>
          <span class="px-2 py-0.5 text-xs bg-white/5 text-secondary rounded-md">عائلة</span>
        </div>
      </div>
    </div>

    <div class="group relative rounded-2xl border border-white/5 bg-white/[0.02] p-6 hover:border-accent/20 transition-all duration-300 mb-16">
      <span class="px-3 py-1 text-xs font-medium bg-white/5 text-secondary rounded-full border border-white/10 mb-4 inline-block">قيد البناء</span>
      <h3 class="text-xl font-bold text-text mb-2 group-hover:text-accent transition-colors">Akila أكيلة</h3>
      <p class="text-secondary text-sm leading-relaxed mb-4 max-w-xl" dir="rtl">طلب طعام جماعي للفرق. مبني للمكاتب.</p>
      <div class="flex flex-wrap gap-2">
        <span class="px-2 py-0.5 text-xs bg-white/5 text-secondary rounded-md">أكل</span>
        <span class="px-2 py-0.5 text-xs bg-white/5 text-secondary rounded-md">فرق</span>
      </div>
    </div>

    <h3 class="text-sm text-secondary uppercase tracking-widest mb-8">المجتمع</h3>
    <div class="grid md:grid-cols-2 gap-4">
      <div class="group p-6 rounded-xl border border-white/5 bg-white/[0.02] hover:border-accent/20 transition-all duration-300">
        <h4 class="text-text font-semibold mb-2 group-hover:text-accent transition-colors" dir="rtl">OpenClaw بالعربي</h4>
        <p class="text-secondary text-sm" dir="rtl">+٩,٦٠٠ باني عربي بيتعلموا وكلاء الذكاء الاصطناعي.</p>
      </div>
      <div class="group p-6 rounded-xl border border-white/5 bg-white/[0.02] hover:border-accent/20 transition-all duration-300">
        <h4 class="text-text font-semibold mb-2 group-hover:text-accent transition-colors" dir="rtl">مستقلو مصر</h4>
        <p class="text-secondary text-sm" dir="rtl">مجتمع مفتوح من +٩,٦٠٠ مستقل.</p>
      </div>
    </div>
  </div>
</Base>
