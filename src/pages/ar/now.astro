---
import Base from '../../layouts/Base.astro';
---

<Base title="الآن" lang="ar">
  <div class="max-w-3xl mx-auto px-6 py-24">
    <h1 class="text-3xl md:text-5xl font-bold text-text mb-4" dir="rtl">الآن<span class="text-accent">.</span></h1>
    <p class="text-secondary text-sm mb-12">آخر تحديث: مايو ٢٠٢٦</p>
    <div class="space-y-8">
      <section>
        <h2 class="text-xl font-semibold text-text mb-3 flex items-center gap-2"><span class="w-2 h-2 bg-accent rounded-full"></span> أبني</h2>
        <ul class="space-y-3 text-secondary leading-relaxed" dir="rtl">
          <li><strong class="text-text">myHR</strong> — نظام موارد بشرية ومرتبات. جاري تجهيزه للإنتاج.</li>
          <li><strong class="text-text">Sanadi سندي</strong> — تطبيق تذكير بالأدوية. تم الإطلاق وجاري التحسين.</li>
          <li><strong class="text-text">Akila أكيلة</strong> — منصة طلب طعام جماعي. قيد التطوير.</li>
          <li><strong class="text-text">Sabbk سبك</strong> — ورشتي التقنية. أبني العلامة التجارية.</li>
        </ul>
      </section>
      <section>
        <h2 class="text-xl font-semibold text-text mb-3 flex items-center gap-2"><span class="w-2 h-2 bg-accent rounded-full"></span> أعمل</h2>
        <p class="text-secondary leading-relaxed" dir="rtl">مطور ووردبريس أول في أندرسن مصر. أقود مشاريع الشركات.</p>
      </section>
      <section>
        <h2 class="text-xl font-semibold text-text mb-3 flex items-center gap-2"><span class="w-2 h-2 bg-accent rounded-full"></span> مبني في</h2>
        <p class="text-secondary leading-relaxed">القاهرة، مصر 🇪🇬</p>
      </section>
    </div>
  </div>
</Base>
