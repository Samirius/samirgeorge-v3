---
import Base from '../../../layouts/Base.astro';
import briefData from '../../../data/news/today.json';
const brief = briefData;
---

<Base title="إشارة — ملخص يومي" lang="ar">
  <article class="max-w-section mx-auto px-6 py-16">
    <header class="mb-16 reveal">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-3xl">📡</span>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight">إشارة</h1>
      </div>
      <p class="text-xl text-secondary max-w-2xl">بدون مبالغة. بدون ضوضاء. اللي يهم بس.</p>
      <div class="mt-6 flex items-center gap-4 text-sm text-secondary">
        <time>{brief.dateFormatted_ar}</time>
        <span>•</span>
        <span class="px-2 py-1 rounded bg-accent/10 text-accent text-xs font-medium">منسق بالذكاء الاصطناعي</span>
        <span>•</span>
        <a href="/signal" class="text-accent hover:underline">Read in English</a>
        <span>•</span>
        <a href="/ar/signal/archive" class="text-secondary hover:text-accent transition-colors">← الأرشيف</a>
      </div>
    </header>

    <section class="mb-16 reveal">
      <div class="bg-surface rounded-2xl p-8 border border-border">
        <h2 class="text-sm font-medium text-accent uppercase tracking-wider mb-4">لقطة اليوم</h2>
        <p class="text-lg leading-relaxed" dir="rtl">{brief.aiSummary_ar}</p>
      </div>
    </section>

    {brief.headline_ar && (
      <section class="mb-16 reveal">
        <div class="border-r-4 border-accent pr-6">
          <h2 class="text-2xl md:text-3xl font-bold mb-2" dir="rtl">{brief.headline_ar}</h2>
        </div>
      </section>
    )}

    <section class="space-y-8 reveal">
      {brief.items.map((item: any, i: number) => (
        <div class="group block bg-surface hover:bg-surfaceHover rounded-xl p-6 border border-border hover:border-accent/20 transition-all">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-xs font-medium px-2 py-1 rounded bg-accent/10 text-accent">{item.category}</span>
            {item.source && <span class="text-xs text-secondary">{item.source}</span>}
          </div>
          <h3 class="text-xl font-semibold mb-2 group-hover:text-accent transition-colors" dir="rtl">{item.title_ar}</h3>
          <p class="text-secondary leading-relaxed" dir="rtl">{item.summary_ar}</p>
        </div>
      ))}
    </section>
  </article>
</Base>
