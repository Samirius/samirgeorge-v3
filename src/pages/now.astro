---
import Base from '../layouts/Base.astro';
---

<Base title="Now">
  <div class="max-w-3xl mx-auto px-6 py-24">
    <h1 class="text-3xl md:text-5xl font-bold text-text mb-4">Now<span class="text-accent">.</span></h1>
    <p class="text-secondary text-sm mb-12">Last updated: May 2026</p>

    <div class="space-y-8">
      <section>
        <h2 class="text-xl font-semibold text-text mb-3 flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span> Building
        </h2>
        <ul class="space-y-3 text-secondary leading-relaxed">
          <li><strong class="text-text">myHR</strong> — HR & Payroll system for MENA businesses. Getting it production-ready.</li>
          <li><strong class="text-text">Sanadi سندي</strong> — Medication reminder app for families. Shipped and iterating.</li>
          <li><strong class="text-text">Akila أكيلة</strong> — Team food ordering platform. In active development.</li>
          <li><strong class="text-text">Sabbk سبك</strong> — My product studio. Building the umbrella brand.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-text mb-3 flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span> Working
        </h2>
        <p class="text-secondary leading-relaxed">Senior WordPress Developer at Andersen Egypt. Leading enterprise projects.</p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-text mb-3 flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span> Learning
        </h2>
        <ul class="space-y-2 text-secondary leading-relaxed">
          <li>AI agents and systems thinking — practical applications for MENA</li>
          <li>Product management and positioning</li>
          <li>Building in public and community leadership</li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-text mb-3 flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span> Based in
        </h2>
        <p class="text-secondary leading-relaxed">Cairo, Egypt 🇪🇬</p>
      </section>
    </div>
  </div>
</Base>
